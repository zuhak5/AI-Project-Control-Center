# Application
NEXT_PUBLIC_APP_NAME="AI Project Control Center"
SESSION_SECRET="generate-a-random-value-of-at-least-32-bytes"
ALLOWED_GITHUB_LOGINS="your-github-login"

# GitHub OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Vercel Blob private store; added automatically when the store is connected
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron authentication
CRON_SECRET="generate-a-random-value-of-at-least-16-bytes"

# Optional outbound restrictions. When set, only these comma-separated hosts may be called.
AICC_ALLOWED_PROVIDER_HOSTS="api.openai.com,api.anthropic.com,generativelanguage.googleapis.com"
AICC_ALLOW_HTTP_PROVIDERS="false"

# Local development only. This is ignored in production.
DEV_BYPASS_AUTH="false"

# Example provider credentials. Project records store only these variable names.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
